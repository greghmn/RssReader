<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RssReader.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RssReader.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RssReader.App">

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
    to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>


  <Grid RowDefinitions="Auto,*"
        ColumnDefinitions="240,1,*">
    <TextBlock Text="RSS Reader"
               FontSize="24"
               FontWeight="Bold"
               Margin="16" />

    <Grid Grid.Row="1"
          Grid.Column="0"
          RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          Margin="16">

      <TextBlock Text="Subscriptions"
                 FontSize="18"
                 FontWeight="SemiBold" />

      <Button Grid.Row="1"
              Content="Add subscription"
              HorizontalAlignment="Stretch"
              Margin="0,8,0,8" Click="AddSubscriptionButton_Click"/>

      <Button Grid.Row="2"
              x:Name="RemoveSubscriptionButton"
              Content="Remove subscription"
              HorizontalAlignment="Stretch"
              Margin="0,0,0,8"
              IsEnabled="{Binding CanRemoveSubscription}"
              Click="RemoveSubscriptionButton_Click" />

      <Grid Grid.Row="3"
            Margin="0,0,0,8">

        <TextBlock Text="Removing subscription..."
                   IsVisible="{Binding IsRemovingSubscription}"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <TextBlock Text="{Binding SubscriptionOperationError}"
                   IsVisible="{Binding SubscriptionOperationError}"
                   Foreground="IndianRed"
                   TextWrapping="Wrap" />

      </Grid>

      <ListBox Grid.Row="4"
               ItemsSource="{Binding Subscriptions}"
               SelectedItem="{Binding SelectedSubscription, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Item.Title}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{Binding UnreadCount}"
                           IsVisible="{Binding HasUnreadCount}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="DodgerBlue"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="5"
                  Spacing="6"
                  Margin="0,8,0,0"
                  IsVisible="{Binding HasSelectedSubscription}">

        <TextBlock Text="Subscription details"
                   FontWeight="SemiBold"
                   FontSize="14" />

        <TextBlock Text="{Binding SelectedSubscription.Item.Title}"
                   FontWeight="SemiBold" />

        <TextBlock Text="Feed URL"
                   FontSize="11"
                   Opacity="0.7" />

        <HyperlinkButton NavigateUri="{Binding SelectedSubscription.FeedUri}"
                         Content="{Binding SelectedSubscription.Item.Url}"
                         HorizontalAlignment="Left" />

      </StackPanel>

    </Grid>

    <Grid Grid.Row="1"
          Grid.Column="2"
          ColumnDefinitions="2*,3*"
          Margin="16">

      <!-- Article list -->
      <Grid Grid.Column="0"
            RowDefinitions="Auto,Auto,Auto,*"
            Margin="0,0,12,0">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Articles"
                     FontSize="18"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />

          <Button Grid.Column="1"
                  Content="↻ Refresh"
                  Command="{Binding RefreshSelectedFeedCommand}"
                  IsEnabled="{Binding CanRemoveSubscription}"
                  Margin="8,0,0,0" />
        </Grid>

        <!-- Current retrieval status -->
        <Grid Grid.Row="1"
              MinHeight="24">
          <TextBlock Text="Select a feed to view its articles."
                     IsVisible="{Binding HasNoSelectedSubscription}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <TextBlock Text="This feed doesn't contain any articles yet."
                     IsVisible="{Binding HasNoArticles}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <TextBlock Text="Loading articles..."
                     IsVisible="{Binding IsLoadingArticles}"
                     Opacity="0.7" />

          <TextBlock Text="Refreshing articles..."
                     IsVisible="{Binding IsRefreshingArticles}"
                     Opacity="0.7" />

          <TextBlock Text="{Binding ArticleLoadError}"
                     IsVisible="{Binding ArticleLoadError}"
                     Foreground="IndianRed"
                     TextWrapping="Wrap" />
        </Grid>

        <!-- Last successful retrieval: placeholder for now -->
        <TextBlock Grid.Row="2"
                   MinHeight="20"
                   Opacity="0.7" />

        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Articles}"
                 SelectedItem="{Binding SelectedArticle, Mode=TwoWay}">


          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto,Auto">

                <!-- Unread indicator -->
                <TextBlock Grid.Column="0"
                           Text="●"
                           Foreground="DodgerBlue"
                           IsVisible="{Binding IsUnread}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <!-- Article title -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Item.Title}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsUnread}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Item.Title}"
                           FontWeight="Normal"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsRead}" />

                <!-- Publication date -->
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding PublishedDateText}"
                           FontSize="11"
                           Opacity="0.7" />

                <!-- Description -->
                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Text="{Binding Item.Description}"
                           TextWrapping="Wrap"
                           Opacity="0.85" />

              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Reading pane -->
      <Border Grid.Column="1"
              BorderBrush="#404040"
              BorderThickness="1,0,0,0"
              Padding="12,0,0,0">

        <Grid>
          <!-- No subscription selected -->
          <TextBlock Text="Select a subscription to view its articles."
                     IsVisible="{Binding HasNoSelectedSubscription}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <!-- Subscription selected, but no article selected -->
          <TextBlock Text="Select an article to start reading."
                     IsVisible="{Binding HasArticlesAwaitingSelection}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <!-- Feed successfully retrieved, but contains no articles -->
          <TextBlock Text="No articles found. This feed was retrieved successfully, but it didn't contain any articles."
                     IsVisible="{Binding HasNoArticles}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <ScrollViewer IsVisible="{Binding HasSelectedArticle}">
            <StackPanel Spacing="8">

              <TextBlock Text="{Binding SelectedArticle.Item.Title}"
                         FontSize="22"
                         FontWeight="Bold"
                         TextWrapping="Wrap" />

              <TextBlock Text="{Binding SelectedArticle.PublishedDateText}"
                         FontSize="12"
                         Opacity="0.7" />
              <TextBlock Text="{Binding ArticleStateError}"
                         IsVisible="{Binding ArticleStateError}"
                         Foreground="IndianRed"
                         TextWrapping="Wrap" />
              <Button Content="Open original article ↗"
                      HorizontalAlignment="Left"
                      IsVisible="{Binding SelectedArticle.CanOpenArticleLink}"
                      Click="OpenArticleLinkButton_Click" />
              <TextBlock Text="{Binding SelectedArticle.Item.Description}"
                         TextWrapping="Wrap" />
              <Button Content="Mark as read"
                      Command="{Binding MarkSelectedArticleAsReadCommand}"
                      IsVisible="{Binding CanMarkSelectedArticleAsRead}" />

              <Button Content="Mark as unread"
                      Command="{Binding MarkSelectedArticleAsUnreadCommand}"
                      IsVisible="{Binding CanMarkSelectedArticleAsUnread}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

    </Grid>

    <Border Grid.Row="1"
            Grid.Column="1"
            BorderBrush="#404040"
            BorderThickness="0,0,1,0" />
  </Grid>
</Window>
