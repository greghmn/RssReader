<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RssReader.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RssReader.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RssReader.App"
        MinWidth="600"
        MinHeight="300">

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
    to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>



  <Grid RowDefinitions="Auto,*">

    <Grid.ColumnDefinitions>
      <!-- Subscriptions pane -->
      <ColumnDefinition Width="160*" MinWidth="172" />

      <!-- Subscriptions / articles splitter -->
      <ColumnDefinition Width="5" />

      <!-- Articles and reading pane container -->
      <ColumnDefinition Width="1040*" MinWidth="330" />
    </Grid.ColumnDefinitions>

    <!-- Header -->
    <TextBlock Text="RSS Reader"
               FontSize="24"
               FontWeight="Bold"
               Margin="16" />
    <!-- Subscription pane -->


    <!-- Subscription pane -->
    <Grid Grid.Row="1"
          Grid.Column="0"
          RowDefinitions="Auto,2*,3*,Auto"
          Margin="16"
          MinWidth="140">

      <!-- Heading -->
      <TextBlock Grid.Row="0"
                 Text="Subscriptions"
                 FontSize="18"
                 FontWeight="SemiBold" />

      <!-- Scrollable subscription controls -->
      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

        <StackPanel Spacing="4"
                    Margin="0,8,0,8">

          <!-- Add subscription -->
          <Button Content="Add subscription"
                  HorizontalAlignment="Stretch"
                  Click="AddSubscriptionButton_Click" />

          <!-- Remove subscription -->
          <Button x:Name="RemoveSubscriptionButton"
                  Content="Remove subscription"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{Binding CanRemoveSubscription}"
                  Click="RemoveSubscriptionButton_Click" />

          <!-- Remove status / error -->
          <StackPanel Spacing="4">

            <TextBlock Text="Removing subscription..."
                       IsVisible="{Binding IsRemovingSubscription}"
                       Opacity="0.7"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding SubscriptionOperationError}"
                       IsVisible="{Binding !!SubscriptionOperationError}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap" />

          </StackPanel>

          <!-- Import OPML -->
          <Button Content="Import OPML..."
                  HorizontalAlignment="Stretch"
                  Margin="0,12,0,0"
                  Click="ImportOpmlButton_Click" />

          <!-- Export OPML -->
          <Button Content="Export OPML..."
                  HorizontalAlignment="Stretch"
                  IsEnabled="{Binding !IsExportingOpml}"
                  Click="ExportOpmlButton_Click" />

          <!-- Import status / error -->
          <StackPanel Spacing="4">

            <TextBlock Text="Importing subscriptions..."
                       IsVisible="{Binding IsImportingOpml}"
                       Opacity="0.7"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding OpmlImportStatus}"
                       IsVisible="{Binding !!OpmlImportStatus}"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding OpmlImportError}"
                       IsVisible="{Binding !!OpmlImportError}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap" />

          </StackPanel>

          <!-- Export status / error -->
          <StackPanel Spacing="4">

            <TextBlock Text="Exporting subscriptions..."
                       IsVisible="{Binding IsExportingOpml}"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding OpmlExportStatus}"
                       IsVisible="{Binding !!OpmlExportStatus}"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding OpmlExportError}"
                       IsVisible="{Binding !!OpmlExportError}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap" />

          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- Subscription list -->
      <ListBox x:Name="SubscriptionList"
               Grid.Row="2"
               MinHeight="40"
               ItemsSource="{Binding Subscriptions}"
               SelectedItem="{Binding SelectedSubscription, Mode=TwoWay}">

        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem"
                        BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu">
              <ContextMenu>
                <MenuItem Header="Refresh"
                          Click="RefreshSubscriptionMenuItem_Click" />

                <MenuItem Header="Open feed URL"
                          Click="OpenFeedUrlMenuItem_Click" />

                <Separator />

                <MenuItem Header="Rename"
                          Click="RenameSubscriptionMenuItem_Click" />

                <MenuItem Header="Remove subscription"
                          Click="RemoveSubscriptionMenuItem_Click" />
              </ContextMenu>
            </Setter>
          </ControlTheme>
        </ListBox.ItemContainerTheme>

        <ListBox.ItemTemplate>

          <DataTemplate>
            <StackPanel Spacing="4">

              <!-- Subscription title and unread count -->
              <Grid ColumnDefinitions="*,Auto">

                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Text="{Binding UnreadCount}"
                           IsVisible="{Binding HasUnreadCount}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="DodgerBlue"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />

              </Grid>

              <!-- Background refresh progress -->
              <TextBlock Text="Refreshing..."
                         IsVisible="{Binding IsRefreshing}"
                         FontSize="11"
                         Opacity="0.7" />

              <!-- Background refresh success -->
              <TextBlock Text="{Binding RefreshStatus}"
                         IsVisible="{Binding !!RefreshStatus}"
                         FontSize="11"
                         Opacity="0.7"
                         TextWrapping="Wrap" />

              <!-- Background refresh failure -->
              <TextBlock Text="{Binding RefreshError}"
                         IsVisible="{Binding !!RefreshError}"
                         FontSize="11"
                         Foreground="IndianRed"
                         TextWrapping="Wrap" />

            </StackPanel>
          </DataTemplate>

        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Scrollable subscription details -->
      <ScrollViewer Grid.Row="3"
                    MinHeight="48"
                    MaxHeight="80"
                    Margin="0,8,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    IsVisible="{Binding HasSelectedSubscription}">

        <StackPanel Spacing="6"
                    Margin="0,0,0,18">

          <TextBlock Text="Subscription details"
                     FontWeight="SemiBold"
                     FontSize="14" />

          <TextBlock Text="{Binding SelectedSubscription.Title}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />

          <TextBlock Text="Feed URL"
                     FontSize="11"
                     Opacity="0.7" />

          <HyperlinkButton NavigateUri="{Binding SelectedSubscription.FeedUri}"
                           Content="{Binding SelectedSubscription.Item.Url}"
                           HorizontalAlignment="Left" />

        </StackPanel>
      </ScrollViewer>

    </Grid>




    <Grid Grid.Row="1"
          Grid.Column="2"
          Margin="16">

      <Grid.ColumnDefinitions>
        <!-- Article list -->
        <ColumnDefinition Width="2*" MinWidth="132" />

        <!-- Article / reading splitter -->
        <ColumnDefinition Width="5" />

        <!-- Reading pane -->
        <ColumnDefinition Width="3*" MinWidth="160" />
      </Grid.ColumnDefinitions>


      <!-- Article list -->
      <Grid Grid.Column="0"
            RowDefinitions="Auto,Auto,Auto,Auto,*"
            Margin="0,0,12,0"
            MinWidth="120">


        <!-- Header -->
        <WrapPanel Orientation="Horizontal"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top">

          <TextBlock Text="Articles"
                     FontSize="18"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="0,0,8,4" />

          <Button Content="↻ Refresh"
                  Command="{Binding RefreshSelectedFeedCommand}"
                  IsEnabled="{Binding CanRefreshSelectedFeed}"
                  Margin="0,0,0,4" />

        </WrapPanel>


        <!-- Current retrieval status -->

        <StackPanel Grid.Row="2"
                    MinHeight="24"
                    Spacing="4">

          <TextBlock Text="Select a feed to view its articles."
                     IsVisible="{Binding HasNoSelectedSubscription}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <TextBlock Text="This feed doesn't contain any articles yet."
                     IsVisible="{Binding HasNoArticles}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <TextBlock Text="Loading articles..."
                     IsVisible="{Binding IsLoadingArticles}"
                     Opacity="0.7" />

          <TextBlock Text="Refreshing articles..."
                     IsVisible="{Binding IsRefreshingArticles}"
                     Opacity="0.7" />

          <TextBlock Text="{Binding ArticleLoadError}"
                     IsVisible="{Binding ArticleLoadError}"
                     Foreground="IndianRed"
                     TextWrapping="Wrap" />

        </StackPanel>



        <TextBlock Grid.Row="3"
                   Text="{Binding SelectedSubscription.LastRetrievedText}"
                   IsVisible="{Binding HasSelectedSubscription}"
                   MinHeight="20"
                   Opacity="0.7" />

        <ListBox x:Name="ArticleList"
                 Grid.Row="4"
                 ItemsSource="{Binding Articles}"
                 SelectedItem="{Binding SelectedArticle, Mode=TwoWay}">


          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto">

                <!-- Unread indicator -->
                <TextBlock Grid.Column="0"
                           Text="●"
                           Foreground="DodgerBlue"
                           IsVisible="{Binding IsUnread}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <!-- Article title -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Item.Title}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsUnread}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Item.Title}"
                           FontWeight="Normal"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsRead}" />

                <!-- Publication date -->
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding PublishedDateText}"
                           FontSize="11"
                           Opacity="0.7" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="1"
                    Width="5"
                    ResizeDirection="Columns"
                    HorizontalAlignment="Stretch"
                    Background="#606060" />

      <!-- Reading pane -->
      <Border Grid.Column="2"
              BorderBrush="#404040"
              BorderThickness="1,0,0,0"
              Padding="12,0,0,0"
              MinWidth="160">

        <Grid>
          <!-- No subscription selected -->
          <TextBlock Text="Select a subscription to view its articles."
                     IsVisible="{Binding HasNoSelectedSubscription}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <!-- Subscription selected, but no article selected -->
          <TextBlock Text="Select an article to start reading."
                     IsVisible="{Binding HasArticlesAwaitingSelection}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <!-- Feed successfully retrieved, but contains no articles -->
          <TextBlock Text="No articles found. This feed was retrieved successfully, but it didn't contain any articles."
                     IsVisible="{Binding HasNoArticles}"
                     Opacity="0.7"
                     TextWrapping="Wrap" />

          <ScrollViewer IsVisible="{Binding HasSelectedArticle}">

            <StackPanel Spacing="8">

              <TextBlock Text="{Binding SelectedArticle.Item.Title}"
                         FontSize="22"
                         FontWeight="Bold"
                         TextWrapping="Wrap" />

              <TextBlock Text="{Binding SelectedArticle.PublishedDateText}"
                         FontSize="12"
                         Opacity="0.7" />

              <TextBlock Text="{Binding ArticleStateError}"
                         IsVisible="{Binding ArticleStateError}"
                         Foreground="IndianRed"
                         TextWrapping="Wrap" />


              <!-- Article actions -->
              <WrapPanel Orientation="Horizontal"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top">


                <Button IsVisible="{Binding SelectedArticle.CanOpenArticleLink}"
                        Click="OpenArticleLinkButton_Click"
                        MaxWidth="130"
                        Margin="0,0,8,4">

                  <TextBlock Text="Open original article ↗"
                             TextWrapping="Wrap"
                             TextAlignment="Center" />

                </Button>


                <Button Content="Mark as read"
                        Command="{Binding MarkSelectedArticleAsReadCommand}"
                        IsVisible="{Binding CanMarkSelectedArticleAsRead}"
                        Margin="0,0,8,4" />

                <Button Content="Mark as unread"
                        Command="{Binding MarkSelectedArticleAsUnreadCommand}"
                        IsVisible="{Binding CanMarkSelectedArticleAsUnread}"
                        Margin="0,0,8,4" />

              </WrapPanel>


              <!-- Article content -->
              <TextBlock Text="{Binding SelectedArticle.DisplayContent}"
                         TextWrapping="Wrap" />

            </StackPanel>

          </ScrollViewer>
        </Grid>
      </Border>

    </Grid>

    <GridSplitter Grid.Row="1"
                  Grid.Column="1"
                  Width="5"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  HorizontalAlignment="Stretch"
                  Background="#606060" />
  </Grid>
</Window>
