<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RssReader.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RssReader.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RssReader.App">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>


    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="240,1,*">
        <TextBlock Text="RSS Reader"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="16" />

<Grid Grid.Row="1"
      Grid.Column="0"
      RowDefinitions="Auto,Auto,Auto,*"
      Margin="16">

    <TextBlock Text="Subscriptions"
               FontSize="18"
               FontWeight="SemiBold" />

    <Button Grid.Row="1"
        Content="Add subscription"
        HorizontalAlignment="Stretch"
        Margin="0,8,0,8" Click="AddSubscriptionButton_Click"/>

    <Button Grid.Row="2"
        x:Name="RemoveSubscriptionButton"
        Content="Remove subscription"
        HorizontalAlignment="Stretch"
        Margin="0,0,0,8"
        IsEnabled="{Binding HasSelectedSubscription}"
        Click="RemoveSubscriptionButton_Click" />

    <ListBox Grid.Row="3"
             ItemsSource="{Binding Subscriptions}"
             SelectedItem="{Binding SelectedSubscription, Mode=TwoWay}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{Binding Url}"
                               FontSize="11"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</Grid>
    
<Grid Grid.Row="1"
      Grid.Column="2"
      ColumnDefinitions="2*,3*"
      Margin="16">

    <!-- Article list -->
    <Grid Grid.Column="0"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
          Margin="0,0,12,0">

        <TextBlock Text="Articles"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Text="Select a feed to view its articles."
                   IsVisible="{Binding HasNoSelectedSubscription}"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="2"
                   Text="This feed doesn't contain any articles yet."
                   IsVisible="{Binding HasNoArticles}"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="3"
                   Text="Loading articles..."
                   IsVisible="{Binding IsLoadingArticles}"
                   Opacity="0.7" />

        <TextBlock Grid.Row="4"
                   Text="{Binding ArticleLoadError}"
                   IsVisible="{Binding ArticleLoadError}"
                   Foreground="IndianRed"
                   TextWrapping="Wrap" />

        <ListBox Grid.Row="5"
                 ItemsSource="{Binding Articles}"
                 SelectedItem="{Binding SelectedArticle, Mode=TwoWay}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
<TextBlock Text="{Binding Item.Title}"
           FontWeight="Bold"
           TextWrapping="Wrap"
           IsVisible="{Binding IsUnread}" />

<TextBlock Text="{Binding Item.Title}"
           FontWeight="Normal"
           TextWrapping="Wrap"
           IsVisible="{Binding IsRead}" />

<TextBlock Text="{Binding Item.PublishedAt}"
           FontSize="11"
           Opacity="0.7" />

<TextBlock Text="{Binding Item.Description}"
           TextWrapping="Wrap"
           Opacity="0.85" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

<!-- Reading pane -->
<Border Grid.Column="1"
        BorderBrush="#404040"
        BorderThickness="1,0,0,0"
        Padding="12,0,0,0">

    <Grid>
        <TextBlock Text="Select an article to start reading."
                   IsVisible="{Binding HasNoSelectedArticle}"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

    <ScrollViewer IsVisible="{Binding HasSelectedArticle}">
        <StackPanel Spacing="8">

<TextBlock Text="{Binding SelectedArticle.Item.Title}"
           FontSize="22"
           FontWeight="Bold"
           TextWrapping="Wrap" />

<TextBlock Text="{Binding SelectedArticle.Item.PublishedAt}"
           FontSize="12"
           Opacity="0.7" />

<TextBlock Text="{Binding SelectedArticle.Item.Description}"
           TextWrapping="Wrap" />
<Button Content="Mark as read"
        Command="{Binding MarkSelectedArticleAsReadCommand}"
        IsVisible="{Binding CanMarkSelectedArticleAsRead}" />

<Button Content="Mark as unread"
        Command="{Binding MarkSelectedArticleAsUnreadCommand}"
        IsVisible="{Binding CanMarkSelectedArticleAsUnread}" />
        </StackPanel>
    </ScrollViewer> 
    </Grid>
</Border>

</Grid>
    
        <Border Grid.Row="1"
            Grid.Column="1"
            BorderBrush="#404040"
            BorderThickness="0,0,1,0" />
</Grid>
</Window>
