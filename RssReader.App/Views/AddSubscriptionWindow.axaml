<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RssReader.App.Views.AddSubscriptionWindow">
    <Grid RowDefinitions="Auto,Auto,*"
      Margin="20">

    <StackPanel Spacing="6">
        <TextBlock Text="Feed URL" />
        <TextBox x:Name="FeedUrlTextBox" PlaceholderText="https://example.com/feed.xml" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Spacing="6"
                Margin="0,12,0,0">
        <TextBlock Text="Display title" />
        <TextBox x:Name="FeedTitleTextBox" PlaceholderText="My favorite feed" />
    </StackPanel>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Spacing="8">
        <Button Content="Cancel" Click="CancelButton_Click"/>
        <Button Content="Add subscription" Click="AddSubscriptionButton_Click"/>
    </StackPanel>

</Grid>
</Window>